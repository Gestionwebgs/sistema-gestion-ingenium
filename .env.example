# Copiar a .env y completar. Ver docker-compose.yml para levantar Postgres y MinIO en local.

DATABASE_URL="postgresql://ingenium:ingenium_dev_password@localhost:5433/ingenium?schema=public"

# MinIO local (equivalente a S3 para desarrollo) / Amazon S3 en producción
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ingenium-comprobantes"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Auth.js (next-auth v5) — generar con `npx auth secret`
AUTH_SECRET=""
