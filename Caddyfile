# Configuración de Caddy para el servidor de producción.
#
# Dominio real ya configurado: gestion.ingeniumservicesac.com
# Caddy pide y renueva el certificado HTTPS solo (Let's Encrypt) en cuanto
# el DNS de ese dominio resuelva hacia la IP de este servidor
# (18.209.97.100). No hace falta hacer nada más que tener el registro DNS
# correcto.
#
# Si en algún momento hay que volver a servir por IP sin dominio (por
# ejemplo mientras se propaga el DNS), descomentá el bloque ":80" de abajo
# y comentá el bloque del dominio.
#
# Después de cambiar este archivo, en el servidor corré:
#   docker compose -f docker-compose.prod.yml restart caddy

gestion.ingeniumservicesac.com {
	reverse_proxy host.docker.internal:3005
}

# :80 {
# 	reverse_proxy host.docker.internal:3005
# }
