# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma init agent-skill reference docs (tooling docs, not project source)
/.agents/
/.windsurf/
/.claude/skills/
/.claude/settings.local.json
skills-lock.json

# tesseract.js OCR language data cache (downloaded on demand, not source)
*.traineddata

# terraform (infra/) — el estado y las variables reales tienen datos
# sensibles (ej. la contraseña de Postgres, tu IP) y no se suben al repo.
# El archivo .terraform.lock.hcl SI se sube (fija las versiones de los
# providers), no está listado acá a propósito.
infra/.terraform/
infra/terraform.tfstate
infra/terraform.tfstate.*
infra/terraform.tfvars
infra/*.tfplan
