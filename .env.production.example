# Copiar a .env EN EL SERVIDOR (nunca en git) y completar.
#
# Diferencias contra .env.example (desarrollo local):
#  - DATABASE_URL usa la contraseña generada por Terraform (ver
#    "terraform output -raw db_password" en infra/), no la de desarrollo.
#  - No hay S3_ENDPOINT ni S3_ACCESS_KEY_ID/SECRET: en el servidor se usa el
#    bucket S3 real (no MinIO) y las credenciales las toma solas del rol IAM
#    de la instancia — más seguro, no hay claves guardadas en este archivo.

DATABASE_URL="postgresql://ingenium:REEMPLAZAR_CON_db_password_DE_TERRAFORM@localhost:5433/ingenium?schema=public"

# La MISMA contraseña de arriba, repetida acá: docker-compose.prod.yml la
# lee de este archivo (Docker Compose carga automáticamente un ".env" que
# esté al lado del docker-compose.yml) para levantar Postgres con esa
# contraseña.
POSTGRES_PASSWORD="REEMPLAZAR_CON_db_password_DE_TERRAFORM"

# Bucket real en AWS (ver "terraform output s3_bucket_name")
S3_REGION="us-east-1"
S3_BUCKET="REEMPLAZAR_CON_s3_bucket_name_DE_TERRAFORM"
# S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_FORCE_PATH_STYLE:
# a propósito NO se setean acá — dejarlas vacías/ausentes para que el SDK
# use el rol IAM de la instancia automáticamente.

# Auth.js (next-auth v5) — generar uno NUEVO acá, no reutilizar el de local:
# npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Usuario owner — se crea la primera vez con `npx prisma db seed`.
# Poné una contraseña fuerte y distinta a la de las otras computadoras.
SEED_OWNER_NAME=""
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
