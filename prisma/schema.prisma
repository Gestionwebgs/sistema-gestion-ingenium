// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Modelo de datos validado con el usuario — ver CLAUDE.md para el contexto completo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  RESPONSABLE
}

enum PaymentSource {
  PERSONAL
  EMPRESA
}

enum ProjectStatus {
  ACTIVO
  FINALIZADO
  PAUSADO
}

enum LoanCurrency {
  PEN
  USD
}

enum LoanStatus {
  PENDIENTE
  PAGADO
}

enum CaptureStatus {
  PENDIENTE
  CLASIFICADO
  DESCARTADA
}

enum PendingTaskSection {
  PROYECTOS
  GESTION_INTERNA
}

enum PendingTaskImportance {
  ALTA
  MEDIA
  BAJA
}

enum PendingTaskStatus {
  PENDIENTE
  EN_CURSO
  CERRADO
}

// El "medio pago" que imprime el proveedor en la factura no es confiable
// (ej. factura dice EFECTIVO pero el pago real fue por Yape/Plin) — este es
// el medio real que la persona usó, elegido a mano, no leído por OCR.
enum PaymentMethod {
  EFECTIVO
  YAPE_PLIN
  TRANSFERENCIA
  TARJETA
  OTRO
}

// Etapa del pipeline comercial de una cotización. Los detalles puntuales
// (N° de OC, si falta un HES, etc.) van en Quote.notes como texto libre —
// solo la etapa general queda como campo fijo, para poder filtrar/reportar.
enum QuoteStage {
  ENVIADA
  EN_EVALUACION
  OC_RECIBIDA
  PAGADA
  RECHAZADA
}

model BusinessLine {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]

  @@map("business_lines")
}

model Client {
  id           String          @id @default(cuid())
  businessName String          @map("business_name")
  ruc          String?
  createdAt    DateTime        @default(now()) @map("created_at")

  contacts ClientContact[]
  projects Project[]

  @@map("clients")
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  projects         Project[]
  billableExpenses Expense[] @relation("ExpenseBillableToClientContact")

  @@map("client_contacts")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(RESPONSABLE)
  createdAt    DateTime @default(now()) @map("created_at")

  responsibleProjects   Project[]              @relation("ProjectResponsible")
  projectMemberships    ProjectMember[]
  orderRevisions        ProjectOrderRevision[]
  paidExpenses          Expense[]              @relation("ExpensePaidBy")
  createdExpenses       Expense[]              @relation("ExpenseCreatedBy")
  uploadedAttachments   ExpenseAttachment[]
  createdIncomes        Income[]
  reimbursementsReceived Reimbursement[]       @relation("ReimbursementPaidTo")
  createdReimbursements Reimbursement[]        @relation("ReimbursementCreatedBy")
  loansReceived         Loan[]                 @relation("LoanBorrower")
  createdLoans          Loan[]                 @relation("LoanCreatedBy")
  createdLoanPayments   LoanPayment[]          @relation("LoanPaymentCreatedBy")
  expenseCaptures       ExpenseCapture[]
  discardedCaptures     ExpenseCapture[]       @relation("ExpenseCaptureDiscardedBy")
  responsiblePendingTasks PendingTask[]        @relation("PendingTaskResponsible")
  createdPendingTasks     PendingTask[]        @relation("PendingTaskCreatedBy")
  createdQuotes           Quote[]              @relation("QuoteCreatedBy")
  createdInvoices         Invoice[]            @relation("InvoiceCreatedBy")

  @@map("users")
}

// Lista de pendientes de la empresa (tareas + seguimiento), replica de la
// hoja de control que ya llevaban en Excel. "PROYECTOS" agrupa por
// proyecto/cliente (ej. "PAMOLSA", "QROMA - ÑAÑA"); "GESTION_INTERNA" agrupa
// por área interna (ej. "GESTION DE FINANZAS"). groupName es texto libre a
// propósito: no siempre corresponde 1:1 con un Project de este sistema.
model PendingTask {
  id                String                 @id @default(cuid())
  section           PendingTaskSection
  groupName         String                 @map("group_name")
  sortOrder         Int                    @default(0) @map("sort_order")
  task              String
  contactName       String?                @map("contact_name")
  importance        PendingTaskImportance?
  responsibleUserId String?                @map("responsible_user_id")
  responsibleUser   User?                  @relation("PendingTaskResponsible", fields: [responsibleUserId], references: [id])
  responsibleName   String?                @map("responsible_name")
  status            PendingTaskStatus      @default(PENDIENTE)
  raisedDate        DateTime?              @map("raised_date")
  dueDate           DateTime?              @map("due_date")
  notes             String?
  createdByUserId   String                 @map("created_by_user_id")
  createdByUser     User                   @relation("PendingTaskCreatedBy", fields: [createdByUserId], references: [id])
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@map("pending_tasks")
}

// Directorio de contactos externos por cliente/servicio — distinto de
// ClientContact (que está atado a un Client formal del sistema). Aquí la
// empresa es texto libre porque incluye clientes sin proyecto formal aún,
// proveedores y hasta empresas del mismo grupo (ej. Ingenium A&R SAC).
model ClientDirectoryContact {
  id              String   @id @default(cuid())
  name            String
  companyName     String   @map("company_name")
  projectOrSite   String?  @map("project_or_site")
  serviceInCharge String?  @map("service_in_charge")
  phone           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("client_directory_contacts")
}

model Project {
  id                  String         @id @default(cuid())
  name                String
  location            String?
  clientId            String?        @map("client_id")
  client              Client?        @relation(fields: [clientId], references: [id])
  clientContactId     String?        @map("client_contact_id")
  clientContact       ClientContact? @relation(fields: [clientContactId], references: [id])
  businessLineId      String         @map("business_line_id")
  businessLine        BusinessLine   @relation(fields: [businessLineId], references: [id])
  responsibleUserId   String?        @map("responsible_user_id")
  responsibleUser     User?          @relation("ProjectResponsible", fields: [responsibleUserId], references: [id])
  responsibleName     String?        @map("responsible_name")
  purchaseOrderNumber String?        @map("purchase_order_number")
  startDate           DateTime?      @map("start_date")
  endDate             DateTime?      @map("end_date")
  orderAmountNoIgv    Decimal        @default(0) @map("order_amount_no_igv") @db.Decimal(12, 2)
  igvAmount           Decimal        @default(0) @map("igv_amount") @db.Decimal(12, 2)
  monthlyTaxPercent   Decimal        @default(0.01) @map("monthly_tax_percent") @db.Decimal(5, 4)
  annualRentPercent   Decimal        @default(0.10) @map("annual_rent_percent") @db.Decimal(5, 4)
  status              ProjectStatus  @default(ACTIVO)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  orderRevisions ProjectOrderRevision[]
  members        ProjectMember[]
  expenses       Expense[]
  incomes        Income[]
  invoices       Invoice[]

  @@map("projects")
}

// Historial de cambios al monto del proyecto (adicionales/ampliaciones).
model ProjectOrderRevision {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  project          Project  @relation(fields: [projectId], references: [id])
  date             DateTime
  orderAmountNoIgv Decimal  @map("order_amount_no_igv") @db.Decimal(12, 2)
  igvAmount        Decimal  @map("igv_amount") @db.Decimal(12, 2)
  reason           String?
  createdByUserId  String   @map("created_by_user_id")
  createdByUser    User     @relation(fields: [createdByUserId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("project_order_revisions")
}

// Permite que varios responsables registren movimientos en un mismo proyecto.
model ProjectMember {
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id])
  role      String?

  @@id([projectId, userId])
  @@map("project_members")
}

// Gastos: siempre se registran, sin importar la fuente de pago.
// projectId es opcional: sin proyecto = gasto general/administrativo de la empresa.
model Expense {
  id                         String         @id @default(cuid())
  projectId                  String?        @map("project_id")
  project                    Project?       @relation(fields: [projectId], references: [id])
  date                       DateTime
  description                String
  operationCode              String?        @map("operation_code")
  amount                     Decimal        @db.Decimal(12, 2)
  paymentSource              PaymentSource  @map("payment_source")
  paymentMethod              PaymentMethod? @map("payment_method")
  paidByUserId               String?        @map("paid_by_user_id")
  paidByUser                 User?          @relation("ExpensePaidBy", fields: [paidByUserId], references: [id])
  paidByName                 String?        @map("paid_by_name")
  billableToClientContactId  String?        @map("billable_to_client_contact_id")
  billableToClientContact    ClientContact? @relation("ExpenseBillableToClientContact", fields: [billableToClientContactId], references: [id])
  billableAmount             Decimal?       @map("billable_amount") @db.Decimal(12, 2)
  notes                      String?
  createdByUserId            String         @map("created_by_user_id")
  createdByUser               User          @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  createdAt                  DateTime       @default(now()) @map("created_at")

  attachments        ExpenseAttachment[]
  reimbursementItems ReimbursementItem[]
  capture            ExpenseCapture?

  @@map("expenses")
}

// Bandeja de fotos de facturas pendientes de clasificar. Captura instantánea desde
// el celular (sin llenar nada); el OCR intenta adivinar los datos; la persona que
// tomó la foto la clasifica después (elige proyecto, personal/empresa, descripción),
// momento en el que se crea el Expense real + su ExpenseAttachment.
model ExpenseCapture {
  id                        String        @id @default(cuid())
  capturedByUserId          String        @map("captured_by_user_id")
  capturedByUser            User          @relation(fields: [capturedByUserId], references: [id])
  fileKey                   String        @map("file_key")
  fileType                  String?       @map("file_type")
  capturedAt                DateTime      @default(now()) @map("captured_at")
  ocrRawText                String?       @map("ocr_raw_text")
  ocrExtractedDate          DateTime?     @map("ocr_extracted_date")
  ocrExtractedAmount        Decimal?      @map("ocr_extracted_amount") @db.Decimal(12, 2)
  ocrExtractedVendor        String?       @map("ocr_extracted_vendor")
  ocrExtractedDocumentNumber String?      @map("ocr_extracted_document_number")
  status                    CaptureStatus @default(PENDIENTE)
  expenseId                 String?       @unique @map("expense_id")
  expense                   Expense?      @relation(fields: [expenseId], references: [id])
  classifiedAt              DateTime?     @map("classified_at")
  // Descarte reversible: no se borra la fila ni el archivo en S3/MinIO, solo
  // se saca de "pendientes" y queda registrado quién y cuándo lo descartó,
  // por si hace falta auditar o recuperar (ver CLAUDE.md).
  discardedAt               DateTime?     @map("discarded_at")
  discardedByUserId         String?       @map("discarded_by_user_id")
  discardedByUser           User?         @relation("ExpenseCaptureDiscardedBy", fields: [discardedByUserId], references: [id])

  @@map("expense_captures")
}

model ExpenseAttachment {
  id               String   @id @default(cuid())
  expenseId        String   @map("expense_id")
  expense          Expense  @relation(fields: [expenseId], references: [id])
  fileKey          String   @map("file_key")
  fileType         String?  @map("file_type")
  uploadedByUserId String   @map("uploaded_by_user_id")
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now()) @map("uploaded_at")

  @@map("expense_attachments")
}

// Abonos/ingresos. projectId opcional por el mismo motivo que Expense.
model Income {
  id              String   @id @default(cuid())
  projectId       String?  @map("project_id")
  project         Project? @relation(fields: [projectId], references: [id])
  date            DateTime
  description     String
  amount          Decimal  @db.Decimal(12, 2)
  createdByUserId String   @map("created_by_user_id")
  createdByUser   User     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("incomes")
}

// El pago del reembolso en sí, como movimiento propio.
// No está atado a un proyecto porque puede cubrir gastos de varios proyectos a la vez.
model Reimbursement {
  id              String   @id @default(cuid())
  date            DateTime
  amount          Decimal  @db.Decimal(12, 2)
  description     String?
  paidToUserId    String?  @map("paid_to_user_id")
  paidToUser      User?    @relation("ReimbursementPaidTo", fields: [paidToUserId], references: [id])
  paidToName      String   @map("paid_to_name")
  createdByUserId String   @map("created_by_user_id")
  createdByUser   User     @relation("ReimbursementCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  items ReimbursementItem[]

  @@map("reimbursements")
}

// Une un reembolso con uno o varios gastos personales; soporta reembolsos parciales o agrupados.
model ReimbursementItem {
  reimbursementId String        @map("reimbursement_id")
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id])
  expenseId       String        @map("expense_id")
  expense         Expense       @relation(fields: [expenseId], references: [id])
  amountApplied   Decimal       @map("amount_applied") @db.Decimal(12, 2)

  @@id([reimbursementId, expenseId])
  @@map("reimbursement_items")
}

// Prestamista (persona o entidad que le presta dinero a la empresa). Un mismo
// prestamista puede tener varios préstamos a lo largo del tiempo — esta ficha
// es lo que permite ver, en un solo lugar, todos sus préstamos, los abonos
// hechos y el saldo total pendiente.
model Lender {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  loans Loan[]

  @@map("lenders")
}

// Dinero prestado por terceros para financiar la operación (incluye deudas de tarjeta
// de crédito atribuidas a una persona). Único módulo con soporte multi-moneda.
model Loan {
  id               String        @id @default(cuid())
  // lenderId es la relación "real" (nueva). lenderName queda como copia de
  // texto (siempre igual a lender.name en préstamos nuevos) para no romper
  // pantallas/reportes viejos y como respaldo si algún préstamo quedara sin
  // prestamista asignado — ver prisma/backfill-lenders.ts.
  lenderId         String?       @map("lender_id")
  lender           Lender?       @relation(fields: [lenderId], references: [id])
  lenderName       String        @map("lender_name")
  borrowerUserId   String?       @map("borrower_user_id")
  borrowerUser     User?         @relation("LoanBorrower", fields: [borrowerUserId], references: [id])
  amount           Decimal       @db.Decimal(12, 2)
  currency         LoanCurrency  @default(PEN)
  // Si se conoce la tasa (ej. 15 = 15%), interestAmount se calcula solo a
  // partir de esa tasa sobre `amount` y se guarda igual — así el resto del
  // sistema (saldo pendiente, etc.) sigue usando un monto, no una tasa.
  interestRate     Decimal?      @map("interest_rate") @db.Decimal(6, 3)
  interestAmount   Decimal?      @map("interest_amount") @db.Decimal(12, 2)
  interestCurrency LoanCurrency? @map("interest_currency")
  // Comisión que cobra el banco por la operación (aparte del interés) — ej. la
  // "+ comisión del banco 4.80" que aparece en la hoja de control de préstamos.
  bankCommission         Decimal?      @map("bank_commission") @db.Decimal(12, 2)
  bankCommissionCurrency LoanCurrency? @map("bank_commission_currency")
  loanDate         DateTime      @map("loan_date")
  dueDate          DateTime?     @map("due_date")
  status           LoanStatus    @default(PENDIENTE)
  notes            String?
  createdByUserId  String        @map("created_by_user_id")
  createdByUser    User          @relation("LoanCreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime      @default(now()) @map("created_at")

  payments LoanPayment[]

  @@map("loans")
}

// Abonos parciales a un préstamo de terceros. El saldo pendiente del
// préstamo se calcula restando los abonos en la misma moneda que el
// principal (loan.currency) — un abono en otra moneda queda registrado
// igual, pero no se compensa automáticamente contra el principal (no hay
// conversión de tipo de cambio en el sistema).
model LoanPayment {
  id              String       @id @default(cuid())
  loanId          String       @map("loan_id")
  loan            Loan         @relation(fields: [loanId], references: [id])
  date            DateTime
  amount          Decimal      @db.Decimal(12, 2)
  currency        LoanCurrency @default(PEN)
  notes           String?
  createdByUserId String       @map("created_by_user_id")
  createdByUser   User         @relation("LoanPaymentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("loan_payments")
}

// Control de cotizaciones enviadas a clientes — réplica del Excel de control
// que ya llevaban ("COTIZACIONES QROMA", y otros por cliente). clientName es
// texto libre (igual que Lender.name) para no obligar a tener un Client
// formal antes de poder registrar una cotización, y porque una empresa
// cliente puede tener cotizaciones sin llegar nunca a ser un Project.
model Quote {
  id            String     @id @default(cuid())
  clientName    String     @map("client_name")
  contactName   String?    @map("contact_name")
  // Código de la cotización tal como lo maneja la empresa (ej. "ISS-021-2026").
  code          String
  project       String
  amountNoIgv   Decimal    @map("amount_no_igv") @db.Decimal(12, 2)
  igvAmount     Decimal    @map("igv_amount") @db.Decimal(12, 2)
  stage         QuoteStage @default(ENVIADA)
  quoteDate     DateTime?  @map("quote_date")
  notes         String?
  createdByUserId String   @map("created_by_user_id")
  createdByUser User       @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@map("quotes")
}

// Facturación/valorizaciones por orden de compra — réplica de la "Relación
// de Órdenes" que se llevaba en Excel, ligada a cada proyecto (una fila por
// factura/valorización enviada, ej. "Valorización 1", "Valorización 2").
// El estado (sin factura / pendiente de pago / pagado) NO se guarda como
// campo: se calcula siempre a partir de hesRequested/hesReceived/paid (ver
// src/app/facturacion/status.ts), para no tener un dato redundante que se
// pueda desincronizar de esos tres campos.
model Invoice {
  id                  String    @id @default(cuid())
  // Opcional (igual que Expense/Income) para poder importar filas que
  // todavía no se identificó a qué proyecto pertenecen — la pantalla de
  // lista avisa si queda alguna así, para asignarla después.
  projectId           String?   @map("project_id")
  project             Project?  @relation(fields: [projectId], references: [id])
  purchaseOrderNumber String?   @map("purchase_order_number")
  quoteCode           String?   @map("quote_code")
  solicitantName      String?   @map("solicitant_name")
  description         String
  hesRequested        Boolean   @default(false) @map("hes_requested")
  hesRequestedDate    DateTime? @map("hes_requested_date")
  hesReceived         Boolean   @default(false) @map("hes_received")
  invoiceEnteredDate  DateTime? @map("invoice_entered_date")
  paid                Boolean   @default(false)
  paidDate            DateTime? @map("paid_date")
  amountNet           Decimal   @map("amount_net") @db.Decimal(12, 2)
  igvAmount           Decimal   @map("igv_amount") @db.Decimal(12, 2)
  // Tasa de detracción (0.12 = 12%) sobre (amountNet + igvAmount) — se
  // guarda por fila porque no todos los servicios tienen la misma tasa.
  detractionPercent   Decimal   @default(0.12) @map("detraction_percent") @db.Decimal(5, 4)
  notes               String?
  createdByUserId     String    @map("created_by_user_id")
  createdByUser       User      @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("invoices")
}
